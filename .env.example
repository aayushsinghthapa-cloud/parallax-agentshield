# Copy to .env and fill in. Never commit .env.
# Free tiers only. Leave a key blank to skip that provider.

# --- Groq (primary, OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Extra Groq models the spike should also try (comma-separated)
GROQ_SPIKE_MODELS=qwen/qwen3.8-27b
# Tokens-per-minute budget we pace ourselves to (free tier is ~8K on gpt-oss-120b)
GROQ_TPM=7500

# --- Gemini (fallback, OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TPM=30000
# Requests per minute we pace ourselves to (free tier limits requests before tokens)
GEMINI_RPM=5

# Order providers are tried in when one is rate-limited or down
PROVIDER_ORDER=groq,gemini

# standard | permissive  (permissive simulates a vulnerable agent; UI shows a badge)
PLANNER_MODE=permissive
# live | record | replay   (replay = recorded LLM answers, no keys or network needed; the guard always runs live)
LLM_MODE=replay
LLM_TEMPERATURE=0.3
# 1 = an LLM proposes the task contract from the user turn only; validated, falls back to the rules
LLM_CONTRACT=0
# Seconds between replayed LLM steps in the UI (pacing only)
REPLAY_DELAY_S=0.8
# 1 = pretend every provider is rate-limited (checks the "Assistant unavailable" path)
SIMULATE_RATE_LIMIT=0
